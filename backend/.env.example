# =============================================================
# Deneyap Depo Yönetimi - Ortam Ayarları (isteğe bağlı)
# Bu dosyayı ".env" adıyla kopyalayın. Hiçbir ayar yapmazsanız sistem
# SQLite ile (backend/deneyap_depo.db) çalışır; çoğu atölye için yeterlidir.
# =============================================================

# --- Veritabanı ---
# sqlite (varsayılan) | mssql
DB_BACKEND=sqlite

# SQL Server kullanılacaksa (pip install -r requirements-mssql.txt):
# DB_BACKEND=mssql
# MSSQL_HOST=localhost              # adlandırılmış örnek için: .\SQLEXPRESS
# MSSQL_DB=deneyap_depo
# MSSQL_WINDOWS_AUTH=1              # 0 yaparsanız MSSQL_USER / MSSQL_PASSWORD kullanılır
# MSSQL_TRUST_CERT=yes
# MSSQL_PORT=                       # boş bırakın (yazılırsa yalnızca TCP denenir)
# MSSQL_DRIVER=                     # boş bırakın (kurulu sürücü otomatik bulunur)

# Bulut / PostgreSQL (Render, Supabase vb.). Tanımlanırsa yukarıdaki ayarları geçersiz kılar.
# DATABASE_URL=postgresql://KULLANICI:SIFRE@SUNUCU:5432/VERITABANI

# --- Güvenlik ---
# Boş bırakılırsa ilk açılışta rastgele bir anahtar üretilip backend/.secret_key dosyasına yazılır.
SECRET_KEY=
ALGORITHM=HS256
# Oturum süresi (dakika). 480 = 8 saat
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- İsteğe bağlı: Supabase Storage (bulutta görsel saklama) ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=product-images
